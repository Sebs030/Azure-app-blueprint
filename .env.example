# Lokale Entwicklung: nach .env.local kopieren.
# Simuliert einen angemeldeten Nutzer, da Easy Auth lokal nicht existiert.
# Greift NIE in Produktion (NODE_ENV=production).
DEV_USER_NAME=max.mustermann@contoso.com
DEV_USER_DISPLAY_NAME=Max Mustermann
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Optional: Azure SQL statt lokalem In-Memory-Speicher (Zugriff per `az login`,
# eigene IP muss in der SQL-Firewall freigegeben sein – Bicep-Parameter devIp).
# SQL_SERVER=intool-sql-xxxx.database.windows.net
# SQL_DATABASE=intool-db
